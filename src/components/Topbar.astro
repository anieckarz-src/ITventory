---
const { user } = Astro.locals;
---

<div
  class="mx-auto flex max-w-7xl flex-col gap-3 rounded-lg border border-slate-200 bg-white/90 px-4 py-3 text-sm text-slate-700 shadow-sm shadow-slate-200/60 backdrop-blur sm:flex-row sm:items-center sm:justify-between"
>
  <a href="/" class="flex items-center gap-3 text-slate-950">
    <span class="flex h-9 w-9 items-center justify-center rounded-md bg-slate-950 text-sm font-semibold text-white">
      IT
    </span>
    <span>
      <span class="block font-semibold">ITventory</span>
      <span class="block text-xs text-slate-500">Inventory and renewals</span>
    </span>
  </a>

  {
    user ? (
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <span class="max-w-full truncate text-xs text-slate-500 sm:max-w-64">{user.email}</span>
        <div class="flex items-center gap-2">
          <a
            href="/dashboard"
            class="inline-flex min-h-10 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-semibold text-white transition-colors hover:bg-slate-800"
          >
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="inline-flex min-h-10 items-center justify-center rounded-md border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-50"
            >
              Sign out
            </button>
          </form>
        </div>
      </div>
    ) : (
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <span class="hidden text-xs font-medium text-slate-500 md:inline">Company-scoped IT records</span>
        <div class="flex items-center gap-2">
          <a
            href="/auth/signin"
            class="inline-flex min-h-10 items-center justify-center rounded-md px-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100"
          >
            Sign in
          </a>
          <a
            href="/auth/signup"
            class="inline-flex min-h-10 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-semibold text-white transition-colors hover:bg-slate-800"
          >
            Start workspace
          </a>
        </div>
      </div>
    )
  }
</div>
