---
import Topbar from "@/components/Topbar.astro";

interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  supportTitle: string;
  supportItems: string[];
}

const { eyebrow, heading, description, supportTitle, supportItems } = Astro.props;
---

<div class="relative min-h-screen w-full overflow-hidden bg-[#f6f8fb] text-slate-950">
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(14,165,233,0.08),rgba(246,248,251,0)_42%),linear-gradient(90deg,rgba(15,23,42,0.05)_1px,transparent_1px),linear-gradient(180deg,rgba(15,23,42,0.05)_1px,transparent_1px)] bg-[size:auto,48px_48px,48px_48px]"
  >
  </div>

  <div class="relative z-10 px-4 py-4 sm:px-6 lg:px-8">
    <Topbar />

    <main class="mx-auto grid max-w-6xl gap-8 py-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:py-16">
      <section class="max-w-2xl">
        <p class="text-sm font-semibold tracking-[0.18em] text-sky-700 uppercase">{eyebrow}</p>
        <h1 class="mt-4 text-4xl leading-tight font-semibold text-slate-950 sm:text-5xl">{heading}</h1>
        <p class="mt-5 text-base leading-7 text-slate-600">{description}</p>

        <div class="mt-8 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-sm font-semibold text-slate-950">{supportTitle}</p>
          <div class="mt-4 grid gap-3">
            {
              supportItems.map((item) => (
                <div class="flex gap-3 rounded-md border border-slate-200 bg-slate-50 p-3">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-sky-500" />
                  <p class="text-sm leading-6 text-slate-600">{item}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="mx-auto w-full max-w-md">
        <slot />
      </section>
    </main>
  </div>
</div>
