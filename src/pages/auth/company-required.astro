---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
---

<Layout title="Company access required">
  <AuthShell
    eyebrow="Workspace boundary"
    heading="Company access is required."
    description="The dashboard only shows company-scoped data when your account has a supported membership."
    supportTitle="Why this block exists"
    supportItems={[
      "Company data should not leak across accounts.",
      "Every dashboard request needs a valid company membership.",
      "Signing out lets you return with the correct workspace account.",
    ]}
  >
    <div class="rounded-lg border border-slate-200 bg-white p-6 text-center shadow-xl shadow-slate-200/80 sm:p-8">
      <span class="inline-flex rounded-md bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
        Access check
      </span>
      <h1 class="mt-4 text-2xl font-semibold text-slate-950">Company access required</h1>
      <p class="mt-3 mb-6 text-sm leading-6 text-slate-600">
        Your account is signed in, but it is not connected to a supported company workspace.
      </p>
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-semibold text-white transition-colors hover:bg-slate-800"
        >
          Sign out
        </button>
      </form>
    </div>
  </AuthShell>
</Layout>
