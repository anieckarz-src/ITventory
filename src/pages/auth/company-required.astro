---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Company access required">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Company access required
      </h1>
      <p class="mb-6 text-blue-100/80">
        Your account is signed in, but it is not connected to a supported company workspace.
      </p>
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
