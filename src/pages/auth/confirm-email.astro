---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
      badge: "Ready",
    }
  : {
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
      badge: "Email check",
    };
---

<Layout title={content.heading}>
  <AuthShell
    eyebrow="Account status"
    heading="Finish workspace access."
    description="ITventory keeps company data behind authenticated access, so account status comes before workspace data."
    supportTitle="What happens next"
    supportItems={[
      "Confirmed users can sign in and open their protected workspace.",
      "Unconfirmed users should use the email link before returning.",
      "Company membership controls dashboard access after authentication.",
    ]}
  >
    <div class="rounded-lg border border-slate-200 bg-white p-6 text-center shadow-xl shadow-slate-200/80 sm:p-8">
      <span class="inline-flex rounded-md bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800">
        {content.badge}
      </span>
      <h1 class="mt-4 text-2xl font-semibold text-slate-950">{content.heading}</h1>
      <p class="mt-3 mb-6 text-sm leading-6 text-slate-600">{content.description}</p>
      <a
        href="/auth/signin"
        class="inline-flex min-h-11 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-semibold text-white transition-colors hover:bg-slate-800"
      >
        {content.linkText}
      </a>
    </div>
  </AuthShell>
</Layout>
