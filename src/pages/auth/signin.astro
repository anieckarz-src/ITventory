---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <AuthShell
    eyebrow="Workspace access"
    heading="Return to your IT workspace."
    description="Sign in to review the company workspace, current role, and the inventory foundation that renewal alerts will build on."
    supportTitle="Keep the operating record close"
    supportItems={[
      "Company data remains scoped to the workspace.",
      "Dashboard access depends on authenticated membership.",
      "Inventory and renewal workflows stay behind the protected app.",
    ]}
  >
    <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/80 sm:p-8">
      <h1 class="text-2xl font-semibold text-slate-950">Sign in</h1>
      <p class="mt-2 mb-6 text-sm leading-6 text-slate-600">Use the email and password attached to your workspace.</p>
      <SignInForm serverError={error} client:load />
      <p class="mt-5 text-center text-sm text-slate-600">
        Don't have an account? <a href="/auth/signup" class="font-semibold text-sky-700 hover:text-sky-800">Sign up</a>
      </p>
    </div>
  </AuthShell>
</Layout>
