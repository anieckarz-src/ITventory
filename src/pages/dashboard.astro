---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import {
  buildDashboardSummary,
  getInventoryRecords,
  type AssignmentRecord,
  type HardwareRecord,
  type InventoryRecords,
  type LicenseRecord,
} from "@/lib/inventory-records";
import { createClient } from "@/lib/supabase";

const { company, role, user } = Astro.locals;
const roleLabel = role === "owner" ? "Owner" : "No role";
const supabase = createClient(Astro.request.headers, Astro.cookies);
const inventoryStatus = Astro.url.searchParams.get("inventory");
const assignmentStatus = Astro.url.searchParams.get("assignment");
const inventoryMessage = Astro.url.searchParams.get("message");
const assignmentMessage = Astro.url.searchParams.get("message");

let inventory: InventoryRecords = {
  employees: [],
  hardware: [],
  licenses: [],
  assignments: [],
  onboardingTemplates: [],
};
let inventoryError: string | null = null;

if (company && supabase) {
  try {
    inventory = await getInventoryRecords(supabase, company.id);
  } catch (error) {
    inventoryError = error instanceof Error ? error.message : "Inventory records could not be loaded.";
  }
}

const dashboardSummary = buildDashboardSummary(inventory);

const canCreateAssignments =
  inventory.employees.length > 0 && inventory.hardware.length > 0 && inventory.licenses.length > 0;

const workspaceSections = [
  {
    title: "Employees",
    count: `${inventory.employees.length} records`,
    description: "People records can become owners for hardware and license assignments in the next slice.",
    status: "Live in inventory records",
  },
  {
    title: "Hardware",
    count: `${inventory.hardware.length} records`,
    description: "Track laptops, phones, serial numbers, and current status.",
    status: "Live in inventory records",
  },
  {
    title: "Licenses",
    count: `${inventory.licenses.length} records`,
    description: "Software subscriptions and renewal dates now feed the product workspace.",
    status: "Live in inventory records",
  },
  {
    title: "Assignments",
    count: `${inventory.assignments.length} current`,
    description: "Connect hardware and software records to employees or devices.",
    status: "Live in asset assignments",
  },
  {
    title: "Renewals",
    count: `${dashboardSummary.renewals.upcoming.length} upcoming`,
    description: "Review the licenses that need attention in the next renewal window.",
    status: "Live in renewal dashboard",
  },
];

const costCards = [
  {
    label: "Monthly software",
    value: formatCurrency(dashboardSummary.software_costs.monthly),
    detail: `${dashboardSummary.software_costs.priced_licenses} licenses with cost`,
  },
  {
    label: "Annual software",
    value: formatCurrency(dashboardSummary.software_costs.annual),
    detail: `${dashboardSummary.software_costs.missing_costs} licenses missing cost`,
  },
  {
    label: "Upcoming renewals",
    value: dashboardSummary.renewals.upcoming.length.toString(),
    detail: `Next ${dashboardSummary.renewals.window_days} days`,
  },
];

const hardwareCards = [
  { label: "Available", value: dashboardSummary.hardware_status.available, accent: "bg-emerald-500" },
  { label: "In use", value: dashboardSummary.hardware_status.in_use, accent: "bg-sky-500" },
  { label: "Retired", value: dashboardSummary.hardware_status.retired, accent: "bg-slate-400" },
];

const inputClass =
  "min-h-10 rounded-md border border-slate-300 bg-white px-3 text-sm text-slate-950 placeholder-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100";
const textareaClass =
  "min-h-20 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 placeholder-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100";
const labelClass = "grid gap-1 text-sm font-medium text-slate-700";
const buttonClass =
  "inline-flex min-h-10 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-semibold text-white transition-colors hover:bg-slate-800";
const secondaryButtonClass =
  "inline-flex min-h-10 items-center justify-center rounded-md border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-50";

function formatCost(license: LicenseRecord) {
  if (license.cost_amount === null) return "No cost";
  return `$${license.cost_amount.toFixed(2)} / ${license.cost_period}`;
}

function formatCurrency(value: number) {
  return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(value);
}

function formatRenewalDate(value: string | null) {
  if (!value) return "No renewal date";
  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(
    new Date(`${value}T00:00:00`),
  );
}

function renewalDueLabel(daysUntilRenewal: number) {
  if (daysUntilRenewal === 0) return "Due today";
  if (daysUntilRenewal === 1) return "Due tomorrow";
  return `Due in ${daysUntilRenewal} days`;
}

function hardwareStatusLabel(status: HardwareRecord["status"]) {
  if (status === "in_use") return "In use";
  if (status === "retired") return "Retired";
  return "Available";
}

function hardwareLabel(asset: Pick<HardwareRecord, "asset_type" | "model" | "serial_number"> | null) {
  if (!asset) return "Unknown hardware";
  return [asset.asset_type, asset.model, asset.serial_number].filter(Boolean).join(" - ");
}

function licenseLabel(license: Pick<LicenseRecord, "name" | "vendor"> | null) {
  if (!license) return "Unknown license";
  return license.vendor ? `${license.name} by ${license.vendor}` : license.name;
}

function assignmentSummary(assignment: AssignmentRecord) {
  if (assignment.assignment_type === "hardware_employee") {
    return `${hardwareLabel(assignment.hardware)} assigned to ${assignment.employee?.full_name ?? "Unknown employee"}`;
  }

  if (assignment.assignment_type === "license_employee") {
    return `${licenseLabel(assignment.license)} assigned to ${assignment.employee?.full_name ?? "Unknown employee"}`;
  }

  return `${licenseLabel(assignment.license)} assigned to ${hardwareLabel(assignment.hardware)}`;
}

function assignmentTypeLabel(assignment: AssignmentRecord) {
  if (assignment.assignment_type === "hardware_employee") return "Hardware to employee";
  if (assignment.assignment_type === "license_employee") return "License to employee";
  return "License to hardware";
}
---

<Layout title="ITventory dashboard">
  <div class="relative min-h-screen w-full overflow-hidden bg-[#f6f8fb] text-slate-950">
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(14,165,233,0.08),rgba(246,248,251,0)_42%),linear-gradient(90deg,rgba(15,23,42,0.05)_1px,transparent_1px),linear-gradient(180deg,rgba(15,23,42,0.05)_1px,transparent_1px)] bg-[size:auto,48px_48px,48px_48px]"
    >
    </div>

    <div class="relative z-10 px-4 py-4 sm:px-6 lg:px-8">
      <Topbar />

      <main class="mx-auto flex max-w-7xl flex-col gap-8 py-10">
        <header class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="text-sm font-semibold tracking-[0.18em] text-sky-700 uppercase">Company workspace</p>
            <h1 class="mt-3 text-4xl leading-tight font-semibold text-slate-950 sm:text-5xl">{company?.name}</h1>
            <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-600">
              Signed in as <span class="font-semibold text-slate-950">{user?.email}</span>. Add the records that will
              power assignments, renewal reviews, and reminders.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <span class="rounded-md border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 shadow-sm">
              Role: <span class="font-semibold text-slate-950">{roleLabel}</span>
            </span>
            <span class="rounded-md bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-800">
              Inventory records live
            </span>
          </div>
        </header>

        {
          inventoryStatus && (
            <div
              class:list={[
                "rounded-md border px-4 py-3 text-sm",
                inventoryStatus === "error"
                  ? "border-red-200 bg-red-50 text-red-700"
                  : "border-sky-200 bg-sky-50 text-sky-800",
              ]}
              role={inventoryStatus === "error" ? "alert" : "status"}
            >
              {inventoryStatus === "error"
                ? (inventoryMessage ?? "Inventory update failed.")
                : inventoryStatus === "deleted"
                  ? "Inventory record deleted."
                  : "Inventory record saved."}
            </div>
          )
        }

        {
          assignmentStatus && (
            <div
              class:list={[
                "rounded-md border px-4 py-3 text-sm",
                assignmentStatus === "error"
                  ? "border-red-200 bg-red-50 text-red-700"
                  : "border-sky-200 bg-sky-50 text-sky-800",
              ]}
              role={assignmentStatus === "error" ? "alert" : "status"}
            >
              {assignmentStatus === "error"
                ? (assignmentMessage ?? "Assignment update failed.")
                : assignmentStatus === "deleted"
                  ? "Assignment removed."
                  : "Assignment saved."}
            </div>
          )
        }

        {
          inventoryError && (
            <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
              {inventoryError}
            </div>
          )
        }

        <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
          {
            workspaceSections.map((section) => (
              <article class="flex min-h-48 flex-col justify-between rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
                <div>
                  <p class="text-sm font-semibold text-slate-500">{section.title}</p>
                  <p class="mt-3 text-2xl font-semibold text-slate-950">{section.count}</p>
                  <p class="mt-4 text-sm leading-6 text-slate-600">{section.description}</p>
                </div>
                <p class="mt-6 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-medium text-slate-600">
                  {section.status}
                </p>
              </article>
            ))
          }
        </section>

        <section class="grid gap-6 xl:grid-cols-[1fr_1.15fr]">
          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <div class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-start">
              <div>
                <p class="text-sm font-semibold text-sky-700 uppercase">Renewal dashboard</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-950">Costs and renewal pressure</h2>
                <p class="mt-3 text-sm leading-6 text-slate-600">
                  Software costs stay split by billing cadence, so monthly subscriptions and annual contracts remain
                  easy to review.
                </p>
              </div>
              <span class="rounded-md bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-800">
                {dashboardSummary.renewals.window_days}-day window
              </span>
            </div>

            <div class="mt-6 grid gap-3 sm:grid-cols-3">
              {
                costCards.map((card) => (
                  <div class="rounded-md border border-slate-200 bg-slate-50 p-4">
                    <p class="text-xs font-semibold text-slate-500 uppercase">{card.label}</p>
                    <p class="mt-3 text-2xl font-semibold text-slate-950">{card.value}</p>
                    <p class="mt-2 text-xs leading-5 text-slate-600">{card.detail}</p>
                  </div>
                ))
              }
            </div>
          </article>

          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
              <div>
                <p class="text-sm font-semibold text-sky-700 uppercase">Hardware status</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-950">
                  {dashboardSummary.hardware_status.total} assets
                </h2>
                <div class="mt-5 grid gap-3">
                  {
                    hardwareCards.map((card) => (
                      <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-md border border-slate-200 p-3">
                        <span class:list={["h-2.5 w-2.5 rounded-full", card.accent]} />
                        <span class="text-sm font-medium text-slate-700">{card.label}</span>
                        <span class="text-sm font-semibold text-slate-950">{card.value}</span>
                      </div>
                    ))
                  }
                </div>
              </div>

              <div>
                <div class="flex items-center justify-between gap-3">
                  <p class="text-sm font-semibold text-slate-950">Upcoming renewals</p>
                  <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">
                    {dashboardSummary.renewals.upcoming.length}
                  </span>
                </div>
                <div class="mt-4 grid gap-3">
                  {
                    dashboardSummary.renewals.upcoming.length === 0 ? (
                      <p class="rounded-md border border-dashed border-slate-300 bg-slate-50 p-4 text-sm leading-6 text-slate-600">
                        No software renewals are due in the next {dashboardSummary.renewals.window_days} days.
                        {dashboardSummary.renewals.missing_dates > 0 &&
                          ` ${dashboardSummary.renewals.missing_dates} licenses still need renewal dates.`}
                      </p>
                    ) : (
                      dashboardSummary.renewals.upcoming.map((renewal) => (
                        <div class="rounded-md border border-slate-200 p-4">
                          <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                              <p class="text-sm font-semibold text-slate-950">{licenseLabel(renewal.license)}</p>
                              <p class="mt-1 text-xs font-medium text-slate-500">
                                {formatRenewalDate(renewal.license.renewal_date)}
                              </p>
                            </div>
                            <span class="rounded-md bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-800">
                              {renewalDueLabel(renewal.days_until_renewal)}
                            </span>
                          </div>
                          <p class="mt-3 text-sm text-slate-600">
                            {formatCost(renewal.license)}
                            {renewal.license.seats ? ` - ${renewal.license.seats} seats` : ""}
                          </p>
                        </div>
                      ))
                    )
                  }
                </div>
              </div>
            </div>
          </article>
        </section>

        <section class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <div class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-start">
              <div>
                <p class="text-sm font-semibold text-sky-700 uppercase">Assignments</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-950">Connect people, hardware, and licenses</h2>
                <p class="mt-3 text-sm leading-6 text-slate-600">
                  Create current-state relationships only. Remove an assignment when a person or device no longer owns
                  that asset.
                </p>
              </div>
              <span class="rounded-md bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-700">
                {inventory.assignments.length} current
              </span>
            </div>

            {
              canCreateAssignments ? (
                <div class="mt-6 grid gap-4 lg:grid-cols-3">
                  <form
                    method="POST"
                    action="/api/assignments"
                    class="grid gap-3 rounded-md border border-slate-200 p-4"
                  >
                    <input type="hidden" name="action" value="create" />
                    <input type="hidden" name="assignment_type" value="hardware_employee" />
                    <p class="text-sm font-semibold text-slate-950">Hardware to employee</p>
                    <label class:list={labelClass}>
                      Hardware
                      <select class:list={inputClass} name="hardware_asset_id" required>
                        {inventory.hardware.map((asset) => (
                          <option value={asset.id}>{hardwareLabel(asset)}</option>
                        ))}
                      </select>
                    </label>
                    <label class:list={labelClass}>
                      Employee
                      <select class:list={inputClass} name="employee_id" required>
                        {inventory.employees.map((employee) => (
                          <option value={employee.id}>{employee.full_name}</option>
                        ))}
                      </select>
                    </label>
                    <label class:list={labelClass}>
                      Notes
                      <textarea class:list={textareaClass} name="notes" placeholder="Optional assignment context" />
                    </label>
                    <button class:list={buttonClass} type="submit">
                      Assign hardware
                    </button>
                  </form>

                  <form
                    method="POST"
                    action="/api/assignments"
                    class="grid gap-3 rounded-md border border-slate-200 p-4"
                  >
                    <input type="hidden" name="action" value="create" />
                    <input type="hidden" name="assignment_type" value="license_employee" />
                    <p class="text-sm font-semibold text-slate-950">License to employee</p>
                    <label class:list={labelClass}>
                      License
                      <select class:list={inputClass} name="software_license_id" required>
                        {inventory.licenses.map((license) => (
                          <option value={license.id}>{licenseLabel(license)}</option>
                        ))}
                      </select>
                    </label>
                    <label class:list={labelClass}>
                      Employee
                      <select class:list={inputClass} name="employee_id" required>
                        {inventory.employees.map((employee) => (
                          <option value={employee.id}>{employee.full_name}</option>
                        ))}
                      </select>
                    </label>
                    <label class:list={labelClass}>
                      Notes
                      <textarea class:list={textareaClass} name="notes" placeholder="Seat, account, or plan context" />
                    </label>
                    <button class:list={buttonClass} type="submit">
                      Assign license
                    </button>
                  </form>

                  <form
                    method="POST"
                    action="/api/assignments"
                    class="grid gap-3 rounded-md border border-slate-200 p-4"
                  >
                    <input type="hidden" name="action" value="create" />
                    <input type="hidden" name="assignment_type" value="license_hardware" />
                    <p class="text-sm font-semibold text-slate-950">License to hardware</p>
                    <label class:list={labelClass}>
                      License
                      <select class:list={inputClass} name="software_license_id" required>
                        {inventory.licenses.map((license) => (
                          <option value={license.id}>{licenseLabel(license)}</option>
                        ))}
                      </select>
                    </label>
                    <label class:list={labelClass}>
                      Hardware
                      <select class:list={inputClass} name="hardware_asset_id" required>
                        {inventory.hardware.map((asset) => (
                          <option value={asset.id}>{hardwareLabel(asset)}</option>
                        ))}
                      </select>
                    </label>
                    <label class:list={labelClass}>
                      Notes
                      <textarea class:list={textareaClass} name="notes" placeholder="Device-specific license context" />
                    </label>
                    <button class:list={buttonClass} type="submit">
                      Assign to device
                    </button>
                  </form>
                </div>
              ) : (
                <p class="mt-6 rounded-md border border-dashed border-slate-300 bg-slate-50 p-4 text-sm leading-6 text-slate-600">
                  Add at least one employee, one hardware record, and one license to unlock all assignment forms.
                </p>
              )
            }
          </article>

          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-xl font-semibold text-slate-950">Current assignments</h2>
            <div class="mt-4 grid gap-3">
              {
                inventory.assignments.length === 0 ? (
                  <p class="rounded-md border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
                    No assignments yet. Connect records to see who has what.
                  </p>
                ) : (
                  inventory.assignments.map((assignment) => (
                    <form method="POST" action="/api/assignments" class="rounded-md border border-slate-200 p-4">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={assignment.id} />
                      <p class="text-xs font-semibold text-sky-700 uppercase">{assignmentTypeLabel(assignment)}</p>
                      <p class="mt-2 text-sm leading-6 font-semibold text-slate-950">{assignmentSummary(assignment)}</p>
                      {assignment.notes && <p class="mt-2 text-sm leading-6 text-slate-600">{assignment.notes}</p>}
                      <button class="mt-3 text-sm font-semibold text-slate-500" type="submit">
                        Remove assignment
                      </button>
                    </form>
                  ))
                )
              }
            </div>
          </article>
        </section>

        <section class="grid gap-6 xl:grid-cols-3">
          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-semibold text-sky-700 uppercase">Employees</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950">People records</h2>
            <form method="POST" action="/api/inventory/employees" class="mt-5 grid gap-3">
              <label class:list={labelClass}>
                Full name
                <input class:list={inputClass} name="full_name" placeholder="Marta Nowak" required />
              </label>
              <label class:list={labelClass}>
                Email
                <input class:list={inputClass} type="email" name="email" placeholder="marta@example.com" />
              </label>
              <label class:list={labelClass}>
                Title
                <input class:list={inputClass} name="title" placeholder="Operations Lead" />
              </label>
              <label class:list={labelClass}>
                Notes
                <textarea class:list={textareaClass} name="notes" placeholder="Useful context for future assignments"
                ></textarea>
              </label>
              <button class:list={buttonClass} type="submit">Add employee</button>
            </form>
          </article>

          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-semibold text-sky-700 uppercase">Hardware</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950">Asset records</h2>
            <form method="POST" action="/api/inventory/hardware" class="mt-5 grid gap-3">
              <label class:list={labelClass}>
                Type
                <input class:list={inputClass} name="asset_type" placeholder="Laptop" required />
              </label>
              <label class:list={labelClass}>
                Model
                <input class:list={inputClass} name="model" placeholder="MacBook Pro 14" required />
              </label>
              <label class:list={labelClass}>
                Serial number
                <input class:list={inputClass} name="serial_number" placeholder="C02..." />
              </label>
              <label class:list={labelClass}>
                Status
                <select class:list={inputClass} name="status">
                  <option value="available">Available</option>
                  <option value="in_use">In use</option>
                  <option value="retired">Retired</option>
                </select>
              </label>
              <label class:list={labelClass}>
                Notes
                <textarea class:list={textareaClass} name="notes" placeholder="Condition, location, warranty context"
                ></textarea>
              </label>
              <button class:list={buttonClass} type="submit">Add hardware</button>
            </form>
          </article>

          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-semibold text-sky-700 uppercase">Licenses</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950">Software records</h2>
            <form method="POST" action="/api/inventory/licenses" class="mt-5 grid gap-3">
              <label class:list={labelClass}>
                License name
                <input class:list={inputClass} name="name" placeholder="Microsoft 365" required />
              </label>
              <label class:list={labelClass}>
                Vendor
                <input class:list={inputClass} name="vendor" placeholder="Microsoft" />
              </label>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class:list={labelClass}>
                  Seats
                  <input class:list={inputClass} type="number" min="1" name="seats" placeholder="10" />
                </label>
                <label class:list={labelClass}>
                  Renewal date
                  <input class:list={inputClass} type="date" name="renewal_date" />
                </label>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class:list={labelClass}>
                  Cost
                  <input
                    class:list={inputClass}
                    type="number"
                    min="0"
                    step="0.01"
                    name="cost_amount"
                    placeholder="99.00"
                  />
                </label>
                <label class:list={labelClass}>
                  Period
                  <select class:list={inputClass} name="cost_period">
                    <option value="monthly">Monthly</option>
                    <option value="annual">Annual</option>
                  </select>
                </label>
              </div>
              <label class:list={labelClass}>
                Notes
                <textarea class:list={textareaClass} name="notes" placeholder="Plan, contract owner, renewal context"
                ></textarea>
              </label>
              <button class:list={buttonClass} type="submit">Add license</button>
            </form>
          </article>
        </section>

        <section class="grid gap-6 xl:grid-cols-3">
          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xl font-semibold text-slate-950">Employees</h2>
              <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">
                {inventory.employees.length}
              </span>
            </div>
            <div class="mt-4 grid gap-3">
              {
                inventory.employees.length === 0 ? (
                  <p class="rounded-md border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
                    Add the first employee to prepare future hardware and license assignments.
                  </p>
                ) : (
                  inventory.employees.map((employee) => (
                    <form
                      method="POST"
                      action="/api/inventory/employees"
                      class="grid gap-3 rounded-md border border-slate-200 p-4"
                    >
                      <input type="hidden" name="id" value={employee.id} />
                      <label class:list={labelClass}>
                        Full name
                        <input class:list={inputClass} name="full_name" value={employee.full_name} required />
                      </label>
                      <label class:list={labelClass}>
                        Email
                        <input class:list={inputClass} type="email" name="email" value={employee.email ?? ""} />
                      </label>
                      <label class:list={labelClass}>
                        Title
                        <input class:list={inputClass} name="title" value={employee.title ?? ""} />
                      </label>
                      <label class:list={labelClass}>
                        Notes
                        <textarea class:list={textareaClass} name="notes">
                          {employee.notes ?? ""}
                        </textarea>
                      </label>
                      <button class:list={secondaryButtonClass} type="submit">
                        Save employee
                      </button>
                    </form>
                  ))
                )
              }
            </div>
          </article>

          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xl font-semibold text-slate-950">Hardware</h2>
              <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">
                {inventory.hardware.length}
              </span>
            </div>
            <div class="mt-4 grid gap-3">
              {
                inventory.hardware.length === 0 ? (
                  <p class="rounded-md border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
                    Add a laptop, phone, or other device to start the hardware register.
                  </p>
                ) : (
                  inventory.hardware.map((asset) => (
                    <div class="rounded-md border border-slate-200 p-4">
                      <form method="POST" action="/api/inventory/hardware" class="grid gap-3">
                        <input type="hidden" name="id" value={asset.id} />
                        <div class="grid gap-3 sm:grid-cols-2">
                          <label class:list={labelClass}>
                            Type
                            <input class:list={inputClass} name="asset_type" value={asset.asset_type} required />
                          </label>
                          <label class:list={labelClass}>
                            Model
                            <input class:list={inputClass} name="model" value={asset.model} required />
                          </label>
                        </div>
                        <label class:list={labelClass}>
                          Serial number
                          <input class:list={inputClass} name="serial_number" value={asset.serial_number ?? ""} />
                        </label>
                        <label class:list={labelClass}>
                          Status
                          <select class:list={inputClass} name="status">
                            <option value="available" selected={asset.status === "available"}>
                              Available
                            </option>
                            <option value="in_use" selected={asset.status === "in_use"}>
                              In use
                            </option>
                            <option value="retired" selected={asset.status === "retired"}>
                              Retired
                            </option>
                          </select>
                        </label>
                        <label class:list={labelClass}>
                          Notes
                          <textarea class:list={textareaClass} name="notes">
                            {asset.notes ?? ""}
                          </textarea>
                        </label>
                        <div class="flex flex-wrap gap-2">
                          <button class:list={secondaryButtonClass} type="submit">
                            Save hardware
                          </button>
                          <button
                            class="text-sm font-semibold text-slate-500"
                            type="submit"
                            name="action"
                            value="delete"
                          >
                            Delete
                          </button>
                        </div>
                      </form>
                      <p class="mt-3 text-xs text-slate-500">Current status: {hardwareStatusLabel(asset.status)}</p>
                    </div>
                  ))
                )
              }
            </div>
          </article>

          <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xl font-semibold text-slate-950">Licenses</h2>
              <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">
                {inventory.licenses.length}
              </span>
            </div>
            <div class="mt-4 grid gap-3">
              {
                inventory.licenses.length === 0 ? (
                  <p class="rounded-md border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
                    Add a software license with renewal date to prepare the renewal dashboard.
                  </p>
                ) : (
                  inventory.licenses.map((license) => (
                    <form
                      method="POST"
                      action="/api/inventory/licenses"
                      class="grid gap-3 rounded-md border border-slate-200 p-4"
                    >
                      <input type="hidden" name="id" value={license.id} />
                      <label class:list={labelClass}>
                        License name
                        <input class:list={inputClass} name="name" value={license.name} required />
                      </label>
                      <label class:list={labelClass}>
                        Vendor
                        <input class:list={inputClass} name="vendor" value={license.vendor ?? ""} />
                      </label>
                      <div class="grid gap-3 sm:grid-cols-2">
                        <label class:list={labelClass}>
                          Seats
                          <input
                            class:list={inputClass}
                            type="number"
                            min="1"
                            name="seats"
                            value={license.seats ?? ""}
                          />
                        </label>
                        <label class:list={labelClass}>
                          Renewal date
                          <input
                            class:list={inputClass}
                            type="date"
                            name="renewal_date"
                            value={license.renewal_date ?? ""}
                          />
                        </label>
                      </div>
                      <div class="grid gap-3 sm:grid-cols-2">
                        <label class:list={labelClass}>
                          Cost
                          <input
                            class:list={inputClass}
                            type="number"
                            min="0"
                            step="0.01"
                            name="cost_amount"
                            value={license.cost_amount ?? ""}
                          />
                        </label>
                        <label class:list={labelClass}>
                          Period
                          <select class:list={inputClass} name="cost_period">
                            <option value="monthly" selected={license.cost_period === "monthly"}>
                              Monthly
                            </option>
                            <option value="annual" selected={license.cost_period === "annual"}>
                              Annual
                            </option>
                          </select>
                        </label>
                      </div>
                      <label class:list={labelClass}>
                        Notes
                        <textarea class:list={textareaClass} name="notes">
                          {license.notes ?? ""}
                        </textarea>
                      </label>
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <button class:list={secondaryButtonClass} type="submit">
                          Save license
                        </button>
                        <span class="text-xs font-medium text-slate-500">{formatCost(license)}</span>
                      </div>
                    </form>
                  ))
                )
              }
            </div>
          </article>
        </section>

        <section class="rounded-lg border border-dashed border-sky-300 bg-sky-50 p-6">
          <p class="text-sm font-semibold text-sky-900">Next slices</p>
          <p class="mt-3 text-sm leading-6 text-sky-800">
            Assignments and renewal dashboard signals are now live. S-05 will use renewal dates for email alerts.
          </p>
        </section>
      </main>
    </div>
  </div>
</Layout>
