---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";

const { company, role, user } = Astro.locals;
const roleLabel = role === "owner" ? "Owner" : "No role";

const workspaceSections = [
  {
    title: "Employees",
    count: "0 records",
    description: "People records will become assignable owners for hardware and licenses.",
    status: "Planned in inventory records",
  },
  {
    title: "Hardware",
    count: "0 records",
    description: "Track laptops, phones, serial numbers, and current ownership here.",
    status: "Planned in inventory records",
  },
  {
    title: "Licenses",
    count: "0 records",
    description: "Software subscriptions and renewal dates will feed dashboard and alerts.",
    status: "Planned in inventory records",
  },
  {
    title: "Renewals",
    count: "No data yet",
    description: "Upcoming renewals will appear once licenses have subscription end dates.",
    status: "Planned in renewal dashboard",
  },
];
---

<Layout title="ITventory dashboard">
  <div class="relative min-h-screen w-full overflow-hidden bg-[#f6f8fb] text-slate-950">
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(14,165,233,0.08),rgba(246,248,251,0)_42%),linear-gradient(90deg,rgba(15,23,42,0.05)_1px,transparent_1px),linear-gradient(180deg,rgba(15,23,42,0.05)_1px,transparent_1px)] bg-[size:auto,48px_48px,48px_48px]"
    >
    </div>

    <div class="relative z-10 px-4 py-4 sm:px-6 lg:px-8">
      <Topbar />

      <main class="mx-auto flex max-w-7xl flex-col gap-8 py-10">
        <header class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="text-sm font-semibold tracking-[0.18em] text-sky-700 uppercase">Company workspace</p>
            <h1 class="mt-3 text-4xl leading-tight font-semibold text-slate-950 sm:text-5xl">{company?.name}</h1>
            <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-600">
              Signed in as <span class="font-semibold text-slate-950">{user?.email}</span>. This workspace is ready for
              the inventory records that will power renewal reviews.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <span class="rounded-md border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 shadow-sm">
              Role: <span class="font-semibold text-slate-950">{roleLabel}</span>
            </span>
            <span class="rounded-md bg-amber-100 px-3 py-2 text-sm font-semibold text-amber-800">
              Inventory data planned
            </span>
          </div>
        </header>

        <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {
            workspaceSections.map((section) => (
              <article class="flex min-h-56 flex-col justify-between rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
                <div>
                  <p class="text-sm font-semibold text-slate-500">{section.title}</p>
                  <p class="mt-3 text-2xl font-semibold text-slate-950">{section.count}</p>
                  <p class="mt-4 text-sm leading-6 text-slate-600">{section.description}</p>
                </div>
                <p class="mt-6 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-medium text-slate-600">
                  {section.status}
                </p>
              </article>
            ))
          }
        </section>

        <section class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-semibold text-sky-700 uppercase">Workspace is ready</p>
            <h2 class="mt-3 text-2xl font-semibold text-slate-950">Start with manual records, then review renewals.</h2>
            <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">
              This company workspace is isolated from other companies and ready for the next inventory slice. Employees,
              hardware, licenses, assignments, and renewal views will build on this company context.
            </p>
          </div>
          <div class="rounded-lg border border-dashed border-sky-300 bg-sky-50 p-6">
            <p class="text-sm font-semibold text-sky-900">Coming next</p>
            <p class="mt-3 text-sm leading-6 text-sky-800">
              Inventory records will turn this empty workspace into the source for assignment tracking and renewal-risk
              review. Email delivery remains planned for a later slice.
            </p>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>
