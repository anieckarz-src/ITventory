---
import Layout from "@/layouts/Layout.astro";

const { company, role, user } = Astro.locals;
const roleLabel = role === "admin" ? "Administrator" : role === "manager" ? "Manager" : "No role";

const workspaceSections = [
  {
    title: "Employees",
    count: "0 records",
    description: "People records will become assignable owners for hardware and licenses.",
    status: "Planned in inventory records",
  },
  {
    title: "Hardware",
    count: "0 records",
    description: "Track laptops, phones, serial numbers, and current ownership here.",
    status: "Planned in inventory records",
  },
  {
    title: "Licenses",
    count: "0 records",
    description: "Software subscriptions and renewal dates will feed dashboard and alerts.",
    status: "Planned in inventory records",
  },
  {
    title: "Renewals",
    count: "No data yet",
    description: "Upcoming renewals will appear once licenses have subscription end dates.",
    status: "Planned in renewal dashboard",
  },
];
---

<Layout title="ITventory dashboard">
  <div class="bg-cosmic min-h-screen p-4 text-white sm:p-6 lg:p-8">
    <div class="mx-auto flex max-w-6xl flex-col gap-6">
      <header class="flex flex-col gap-4 border-b border-white/10 pb-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-medium tracking-[0.18em] text-blue-100/60 uppercase">Company workspace</p>
          <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl">{company?.name}</h1>
          <p class="mt-2 text-sm text-blue-100/70">
            Signed in as <span class="font-medium text-white">{user?.email}</span>
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:items-end">
          <span class="rounded-md border border-white/15 bg-white/10 px-3 py-2 text-sm text-blue-100">
            Role: <span class="font-semibold text-white">{roleLabel}</span>
          </span>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-md border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium transition-colors hover:bg-white/20"
            >
              Sign out
            </button>
          </form>
        </div>
      </header>

      <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {
          workspaceSections.map((section) => (
            <article class="flex min-h-56 flex-col justify-between rounded-lg border border-white/10 bg-white/10 p-5 backdrop-blur-xl">
              <div>
                <p class="text-sm font-medium text-blue-100/60">{section.title}</p>
                <p class="mt-3 text-2xl font-semibold text-white">{section.count}</p>
                <p class="mt-4 text-sm leading-6 text-blue-100/70">{section.description}</p>
              </div>
              <p class="mt-6 rounded-md border border-white/10 bg-black/10 px-3 py-2 text-xs font-medium text-blue-100/65">
                {section.status}
              </p>
            </article>
          ))
        }
      </section>

      <section class="rounded-lg border border-white/10 bg-white/10 p-5 backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-white">Workspace is ready</h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-blue-100/70">
          This company workspace is isolated from other companies and ready for the next inventory slice. Additions for
          employees, hardware, licenses, assignments, and renewal views will build on this company context.
        </p>
      </section>
    </div>
  </div>
</Layout>
